{
  "name": "dead-code-finder",
  "version": "1.0.0",
  "description": "AI-powered dead code finder using GitHub Copilot SDK. Identifies unused functions, orphaned modules, dead APIs, and unreachable code, then suggests cleanup PRs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dead-code-finder": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "action/",
    "README.md"
  ],
  "keywords": [
    "dead-code",
    "unused-code",
    "static-analysis",
    "copilot",
    "github-copilot-sdk",
    "code-cleanup",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^0.1.0",
    "@octokit/rest": "^21.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
